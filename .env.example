# Copy to .env for local development: cp .env.example .env
# Ports match docker-compose.yml (5436 avoids clashing with other local Postgres instances).
# All credentials below are throwaway local-development values.

# Runtime connection: restricted role, subject to Row Level Security.
DATABASE_URL="postgresql://rotiqa_app:rotiqa_app_dev@localhost:5436/rotiqa"
# Migrations only: table owner. Never used by the running app.
MIGRATION_DATABASE_URL="postgresql://rotiqa:rotiqa@localhost:5436/rotiqa"

# Integration / e2e tests run against a separate database with the same two roles.
TEST_DATABASE_URL="postgresql://rotiqa_app:rotiqa_app_dev@localhost:5436/rotiqa_test"
TEST_MIGRATION_DATABASE_URL="postgresql://rotiqa:rotiqa@localhost:5436/rotiqa_test"

# Isolated demo database (public live demo, fake data only — phase F6).
DEMO_DATABASE_URL="postgresql://rotiqa_app:rotiqa_app_dev@localhost:5436/rotiqa_demo"

# Better Auth. Generate a real secret for any shared environment: openssl rand -base64 32
BETTER_AUTH_SECRET="local-development-secret-change-me-0000000000"
BETTER_AUTH_URL="http://localhost:3000"
