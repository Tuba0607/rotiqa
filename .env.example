# Copy to .env for local development: cp .env.example .env
# Ports match docker-compose.yml (5436 avoids clashing with other local Postgres instances).

# Primary application database (real tenants)
DATABASE_URL="postgresql://rotiqa:rotiqa@localhost:5436/rotiqa?schema=public"

# Isolated demo database (public live demo, fake data only)
DEMO_DATABASE_URL="postgresql://rotiqa:rotiqa@localhost:5436/rotiqa_demo?schema=public"
